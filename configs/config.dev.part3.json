{
  "patches-version": "dev",
  "enable-module-update": true,
  "youtube-morphe-amoled": {
    "enabled": true,
    "app-name": "youtube",
    "rv-brand": "morphe-amoled",
    "build-mode": "both",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.google.android.youtube",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "MorpheApp/morphe-patches",
    "included-patches": [
      "Theme"
    ],
    "patcher-args": "-OdarkThemeBackgroundColor=#000000 -OlightThemeBackgroundColor=#FFFFFF",
    "uptodown-dlurl": "https://youtube.en.uptodown.com/android",
    "apkmirror-dlurl": "https://apkmirror.com/apk/google-inc/youtube",
    "apkpure-dlurl": "https://apkpure.com/youtube-app/com.google.android.youtube",
    "apkcombo-dlurl": "https://apkcombo.com/youtube/com.google.android.youtube",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.google.android.youtube"
  },
  "cricbuzz-morphe-paresh-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "cricbuzz",
    "rv-brand": "morphe-paresh-exp",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.cricbuzz.android",
    "version": "latest",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.cricbuzz.android",
    "uptodown-dlurl": "https://cricbuzz-cricket-scores-and-news.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/cricbuzz-com/cricbuzz-live-cricket-scores-news",
    "patches-source": "Paresh-Maheshwari/paresh-patches",
    "patches-source-host": "gitlab"
  }
}
