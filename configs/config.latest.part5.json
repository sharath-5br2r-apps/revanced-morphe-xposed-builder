{
  "patches-version": "absolutelatest",
  "enable-module-update": true,
  "brave-nightly-morphe-dh6k-arm-v7a": {
    "enabled": true,
    "app-name": "brave-nightly",
    "rv-brand": "morphe-dh6k",
    "build-mode": "apk",
    "arch": "arm-v7a",
    "pkg-name": "com.brave.browser_nightly",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "repo-dlurl": "https://github.com/brave/brave-browser/releases",
    "repo-dlurl-filter": "(BraveMonoarm|MonoArm)\\.apk$",
    "repo-dlurl-release-name-filter": "^Nightly v"
  },
  "jiohotstar-morphe-paresh-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "jiohotstar",
    "rv-brand": "morphe-paresh-exp",
    "version": "latest",
    "build-mode": "apk",
    "pkg-name": "in.startv.hotstar",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/jiostar-india-private-limited/jiohotstar-4/",
    "apkmirror-example-url": "https://www.apkmirror.com/apk/jiostar-india-private-limited/jiohotstar-4/jiohotstar-26-08-03-2-release/",
    "dpi": "nodpi anydpi auto",
    "github-dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/in.startv.hotstar",
    "patches-source": "Paresh-Maheshwari/paresh-patches",
    "patches-source-host": "gitlab"
  }
}
