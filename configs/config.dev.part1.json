{
  "patches-version": "dev",
  "enable-module-update": true,
  "brave-beta-morphe-dh6k": {
    "enabled": true,
    "app-name": "brave-beta",
    "rv-brand": "morphe-dh6k",
    "version": "beta",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.brave.browser_beta",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-dlurl-regex": [
      {
        "arch": "arm64-v8a",
        "regex": "(BraveMonoarm64|MonoArm64)\\.apk$"
      },
      {
        "arch": "arm-v7a",
        "regex": "(BraveMonoarm|MonoArm)\\.apk$"
      },
      {
        "arch": "x86_64",
        "regex": "(BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$"
      }
    ],
    "github-release-name-regex": "^Beta v"
  },
  "jetpack-joyride-morphe-byehi98": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "jetpack-joyride",
    "rv-brand": "morphe-byehi98",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.halfbrick.jetpackjoyride",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.halfbrick.jetpackjoyride",
    "uptodown-dlurl": "https://jetpack-joyride.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/halfbrick-studios/jetpack-joyride/",
    "apkmirror-example-url": "https://www.apkmirror.com/apk/halfbrick-studios/jetpack-joyride/jetpack-joyride-1-104-1-release/",
    "dpi": [
      "nodpi",
      "anydpi",
      "auto"
    ],
    "patches-source": "byehi98/okish-morphe-patches"
  }
}
