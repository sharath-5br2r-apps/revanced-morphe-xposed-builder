{
  "patches-version": "dev",
  "enable-module-update": true,
  "brave-nightly-morphe-dh6k": {
    "enabled": true,
    "app-name": "brave-nightly",
    "rv-brand": "morphe-dh6k",
    "version": "beta",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.brave.browser_nightly",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-dlurl-regex": [
      {
        "arch": "arm64-v8a",
        "regex": "(BraveMonoarm64|MonoArm64)\\.apk$"
      },
      {
        "arch": "arm-v7a",
        "regex": "(BraveMonoarm|MonoArm)\\.apk$"
      },
      {
        "arch": "x86_64",
        "regex": "(BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$"
      }
    ],
    "github-release-name-regex": "^Nightly v"
  },
  "youtube-music-morphe-exp": {
    "enabled": true,
    "app-name": "youtube-music",
    "rv-brand": "morphe-exp",
    "build-mode": "both",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "version": "exp",
    "pkg-name": "com.google.android.apps.youtube.music",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "MorpheApp/morphe-patches",
    "included-patches": [
      "Theme"
    ],
    "uptodown-dlurl": "https://youtube-music.en.uptodown.com/android",
    "apkmirror-dlurl": "https://apkmirror.com/apk/google-inc/youtube-music",
    "apkpure-dlurl": "https://apkpure.com/youtube-music/com.google.android.apps.youtube.music",
    "apkcombo-dlurl": "https://apkcombo.com/youtube-music/com.google.android.apps.youtube.music",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.google.android.apps.youtube.music"
  }
}
