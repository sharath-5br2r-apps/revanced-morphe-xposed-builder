{
  "patches-version": "latest",
  "enable-module-update": true,
  "brave-beta-morphe-dh6k-arm-v7a": {
    "enabled": true,
    "app-name": "brave-beta",
    "rv-brand": "morphe-dh6k",
    "build-mode": "apk",
    "arch": "arm-v7a",
    "pkg-name": "com.brave.browser_beta",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "repo-dlurl": "https://github.com/brave/brave-browser/releases",
    "repo-dlurl-filter": "(BraveMonoarm|MonoArm)\\.apk$",
    "repo-dlurl-release-name-filter": "^Beta v"
  },
  "xrecorder-morphe-hoodles-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "xrecorder",
    "rv-brand": "morphe-hoodles-exp",
    "github-dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/videoeditor.videorecorder.screenrecorder",
    "version": "latest",
    "build-mode": "apk",
    "arch": "all",
    "pkg-name": "videoeditor.videorecorder.screenrecorder",
    "uptodown-dlurl": "https://videoeditor-videorecorder-screenrecorder.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/inshot-inc-2/screen-recorder-video-recorder-xrecorder",
    "dpi": "nodpi anydpi auto",
    "patches-source": "hoo-dles/morphe-patches"
  },
  "adguard-morphe-rushiranpise-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "adguard",
    "rv-brand": "morphe-rushiranpise-exp",
    "github-dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.adguard.android",
    "version": "latest",
    "custom-microg-patches": "'None'",
    "build-mode": "apk",
    "arch": "all",
    "pkg-name": "com.adguard.android",
    "uptodown-dlurl": "https://adguard-for-android.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/adguard-software-limited/adguard",
    "dpi": "nodpi anydpi auto",
    "patches-source": "rushiranpise/morphe-patches"
  }
}
