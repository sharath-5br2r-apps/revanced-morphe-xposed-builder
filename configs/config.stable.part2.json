    "build-mode": "apk",
    "arch": "all",
    "pkg-name": "com.halfbrick.jetpackjoyride",
    "uptodown-dlurl": "https://jetpack-joyride.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/halfbrick-studios/jetpack-joyride/",
