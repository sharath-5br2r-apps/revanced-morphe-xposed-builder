    "dpi": "nodpi anydpi auto",
    "patches-source": "byehi98/okish-morphe-patches"
  },
  "xrecorder-morphe-hoodles-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
