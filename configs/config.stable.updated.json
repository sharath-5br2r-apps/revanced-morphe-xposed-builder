{
  "patches-version": "latest",
  "enable-module-update": true,
  "brave-stable-morphe-kveld9": {
    "enabled": true,
    "app-name": "brave-stable",
    "rv-brand": "morphe-kveld9",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.brave.browser",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "kveld9/kveld-morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-dlurl-regex": [
      {
        "arch": "arm64-v8a",
        "regex": "(BraveMonoarm64|MonoArm64)\\.apk$"
      },
      {
        "arch": "arm-v7a",
        "regex": "(BraveMonoarm|MonoArm)\\.apk$"
      },
      {
        "arch": "x86_64",
        "regex": "(BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$"
      }
    ],
    "github-release-name-regex": "^Release v"
  },
  "github-morphe-hoodles-stylus-exp": {
    "enabled": true,
    "app-name": "github",
    "rv-brand": "morphe-hoodles-stylus-exp",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.github.android",
    "cli-source": "MorpheApp/morphe-desktop",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/github/github-2",
    "apkmirror-example-url": "https://www.apkmirror.com/apk/github/github-2/github-1-202-0-release/",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.github.android",
    "patches-source": [
      "hoo-dles/morphe-patches",
      "ch3thanhs/stylus"
    ],
    "included-patches": [
      [
        "AMOLED dark theme"
      ],
      [
        "Force system font (including monospace) (GitHub)"
      ]
    ],
    "dpi": "480-640dpi",
    "version": "latest"
  },
  "windscribe-vpn-morphe-rushiranpise-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "windscribe-vpn",
    "rv-brand": "morphe-rushiranpise-exp",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.windscribe.vpn",
    "version": "latest",
    "custom-microg-patches": "'None'",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.windscribe.vpn",
    "uptodown-dlurl": "https://windscribe.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/windscribe/windscribe-vpn",
    "apkcombo-dlurl": "https://apkcombo.com/windscribe/com.windscribe.vpn",
    "dpi": [
      "nodpi",
      "anydpi",
      "auto"
    ],
    "patches-source": "rushiranpise/morphe-patches"
  }
}
