{
  "patches-version": "latest",
  "enable-module-update": true,
  "brave-stable-morphe-kveld9": {
    "enabled": true,
    "app-name": "brave-stable",
    "rv-brand": "morphe-kveld9",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.brave.browser",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "kveld9/kveld-morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-dlurl-regex": [
      {
        "arch": "arm64-v8a",
        "regex": "(BraveMonoarm64|MonoArm64)\\.apk$"
      },
      {
        "arch": "arm-v7a",
        "regex": "(BraveMonoarm|MonoArm)\\.apk$"
      },
      {
        "arch": "x86_64",
        "regex": "(BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$"
      }
    ],
    "github-release-name-regex": "^Release v"
  },
  "brave-nightly-morphe-dh6k": {
    "enabled": true,
    "app-name": "brave-nightly",
    "rv-brand": "morphe-dh6k",
    "version": "beta",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.brave.browser_nightly",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-dlurl-regex": [
      {
        "arch": "arm64-v8a",
        "regex": "(BraveMonoarm64|MonoArm64)\\.apk$"
      },
      {
        "arch": "arm-v7a",
        "regex": "(BraveMonoarm|MonoArm)\\.apk$"
      },
      {
        "arch": "x86_64",
        "regex": "(BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$"
      }
    ],
    "github-release-name-regex": "^Nightly v"
  },
  "soundcloud-morphe-kondratjev": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "soundcloud",
    "rv-brand": "morphe-kondratjev",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.soundcloud.android",
    "version": "auto",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.soundcloud.android",
    "uptodown-dlurl": "https://soundcloud.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/soundcloud/soundcloud-soundcloud/",
    "apkmirror-example-url": "https://www.apkmirror.com/apk/soundcloud/soundcloud-soundcloud/soundcloud-the-music-you-love-2026-07-23-release-release",
    "apkpure-dlurl": "https://apkpure.com/sound-cloud-android-app/com.soundcloud.android",
    "apkcombo-dlurl": "https://apkcombo.com/soundcloud/com.soundcloud.android",
    "patches-source": "kondratjev/morphe-patches"
  },
  "x-morphe-piko-exp": {
    "enabled": true,
    "app-name": "x",
    "rv-brand": "morphe-piko-exp",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "version": "latest",
    "pkg-name": "com.twitter.android",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "crimera/piko",
    "patches-source-host": "github",
    "excluded-patches": [
      "Dynamic Color"
    ],
    "patcher-args": "--continue-on-error",
    "uptodown-dlurl": "https://twitter.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/x-corp/twitter/",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.twitter.android"
  },
  "x-morphe-piko-materialyou-exp": {
    "enabled": true,
    "app-name": "x",
    "rv-brand": "morphe-piko-materialyou-exp",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "version": "latest",
    "pkg-name": "com.twitter.android",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "crimera/piko",
    "patches-source-host": "github",
    "included-patches": [
      "Dynamic Color"
    ],
    "patcher-args": "--continue-on-error",
    "uptodown-dlurl": "https://twitter.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/x-corp/twitter/",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.twitter.android"
  },
  "adguard-morphe-rushiranpise-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "adguard",
    "rv-brand": "morphe-rushiranpise-exp",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.adguard.android",
    "version": "latest",
    "custom-microg-patches": "'None'",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.adguard.android",
    "uptodown-dlurl": "https://adguard-for-android.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/adguard-software-limited/adguard",
    "patches-source": "rushiranpise/morphe-patches"
  }
}
