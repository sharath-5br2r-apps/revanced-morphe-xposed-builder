{
  "patches-version": "latest",
  "enable-module-update": true,
  "BraveBrowser-Morphe-Kveld9": {
    "enabled": true,
    "app-name": "Brave Browser",
    "engine-brand": "Morphe",
    "patch-brand": "Kveld9",
    "build-mode": "apk",
    "arch": "arm64-v8a arm-v7a x86_64",
    "pkg-name": "com.brave.browser",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "kveld9/kveld-morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-dlurl-regex": "arm64-v8a: (BraveMonoarm64|MonoArm64)\\.apk$ | arm-v7a: (BraveMonoarm|MonoArm)\\.apk$ | x86_64: (BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$",
    "github-release-name-regex": "^Release v"
  },
  "Twitter-Morphe-Piko-Experimental": {
    "enable-module-update": true,
    "patches-version": "absolutelatest",
    "enabled": true,
    "app-name": "Twitter",
    "engine-brand": "Morphe",
    "patch-brand": "Piko",
    "sub-variant": "Experimental",
    "build-mode": "apk",
    "arch": "all arm64-v8a arm-v7a x86_64",
    "version": "latest",
    "pkg-name": "com.twitter.android",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "crimera/piko",
    "patches-source-host": "github",
    "excluded-patches": "'Dynamic Color'",
    "patcher-args": "--continue-on-error",
    "uptodown-dlurl": "https://twitter.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/x-corp/twitter/",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.twitter.android"
  },
  "Twitter-Morphe-Piko-MaterialYou-Experimental": {
    "enable-module-update": true,
    "patches-version": "absolutelatest",
