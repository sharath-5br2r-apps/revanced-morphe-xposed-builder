{
  "patches-version": "latest",
  "enable-module-update": true,
  "inshorts-morphe-xtra-exp": {
    "enabled": true,
    "app-name": "inshorts",
    "rv-brand": "morphe-xtra-exp",
    "pkg-name": "com.nis.app",
    "build-mode": "apk",
    "version": "latest",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "cli-source": "MorpheApp/morphe-desktop",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.nis.app",
    "uptodown-dlurl": "https://inshorts.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/inshorts-formerly-news-in-shorts/inshorts-news-in-60-words-2/",
    "patches-source": "BholeyKaBhakt/revanced-patches-xtra"
  },
  "brave-nightly-morphe-dh6k": {
    "enabled": true,
    "app-name": "brave-nightly",
    "rv-brand": "morphe-dh6k",
    "version": "beta",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.brave.browser_nightly",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-dlurl-regex": [
      {
        "arch": "arm64-v8a",
        "regex": "(BraveMonoarm64|MonoArm64)\\.apk$"
      },
      {
        "arch": "arm-v7a",
        "regex": "(BraveMonoarm|MonoArm)\\.apk$"
      },
      {
        "arch": "x86_64",
        "regex": "(BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$"
      }
    ],
    "github-release-name-regex": "^Nightly v"
  },
  "amazon-alexa-signed": {
    "enabled": true,
    "app-name": "amazon-alexa",
    "rv-brand": "signed",
    "build-mode": "apk",
    "cli-source": "apksigner",
    "pkg-name": "com.amazon.dee.app",
    "cli-source-host": "none",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.amazon.dee.app",
    "patches-source": "none",
    "patches-source-host": "none",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "prefer-dl-mode": "bundle",
    "uptodown-dlurl": "https://alexa.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/amazon-mobile-llc/amazon-alexa/",
    "dpi": [
      "120-480dpi",
      "480-640dpi"
    ]
  }
}
