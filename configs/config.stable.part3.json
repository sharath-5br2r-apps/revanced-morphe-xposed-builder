{
  "patches-version": "latest",
  "enable-module-update": true,
  "brave-stable-morphe-kveld9-x86_64": {
    "enabled": true,
    "app-name": "brave-stable",
    "rv-brand": "morphe-kveld9",
    "build-mode": "apk",
    "arch": "x86_64",
    "pkg-name": "com.brave.browser",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "kveld9/kveld-morphe-patches",
    "patcher-args": "--continue-on-error",
    "repo-dlurl": "https://github.com/brave/brave-browser/releases",
    "repo-dlurl-filter": "(BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$",
    "repo-dlurl-release-name-filter": "^Release v"
  },
  "camscanner-morphe-hoodles": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "camscanner",
    "rv-brand": "morphe-hoodles",
    "github-dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.intsig.camscanner",
    "build-mode": "apk",
    "arch": "all arm64-v8a",
    "pkg-name": "com.intsig.camscanner",
    "uptodown-dlurl": "https://camscanner-pdf-creator.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/intsig-pte/camscanner-phone-pdf-creator",
    "apkmirror-example-url": "https://www.apkmirror.com/apk/intsig-pte/camscanner-phone-pdf-creator/camscanner-scanner-pdf-maker-7-24-0-2608130000-release/",
    "apkpure-dlurl": "https://apkpure.com/camscanner-scanner-pdf-maker/com.intsig.camscanner",
    "apkcombo-dlurl": "https://apkcombo.com/camscanner/com.intsig.camscanner",
    "dpi": "nodpi anydpi auto",
    "patches-source": "hoo-dles/morphe-patches",
    "patcher-args": "--continue-on-error"
  },
  "smart-launcher-6-morphe-hoodles": {
    "enabled": false,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "smart-launcher-6",
    "rv-brand": "morphe-hoodles",
    "github-dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/ginlemon.flowerfree",
    "build-mode": "apk",
    "arch": "all",
    "pkg-name": "ginlemon.flowerfree",
    "uptodown-dlurl": "https://smart-launcher.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/smart-launcher-team/smart-launcher",
    "dpi": "nodpi anydpi auto",
    "patches-source": "hoo-dles/morphe-patches"
  },
  "xodo-morphe-hoodles-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "xodo",
    "rv-brand": "morphe-hoodles-exp",
    "github-dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.xodo.pdf.reader",
    "version": "latest",
    "build-mode": "apk",
    "arch": "arm64-v8a arm-v7a x86_64",
    "pkg-name": "com.xodo.pdf.reader",
    "uptodown-dlurl": "https://xodo-pdf-reader-editor.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/xodo-technologies-inc/xodo-pdf-reader-editor",
    "dpi": "nodpi anydpi auto",
    "patches-source": "hoo-dles/morphe-patches"
  }
}
