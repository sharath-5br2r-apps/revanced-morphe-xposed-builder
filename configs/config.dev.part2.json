{
  "patches-version": "dev",
  "enable-module-update": true,
  "youtube-morphe-anddea-amoled": {
    "enabled": true,
    "app-name": "youtube",
    "rv-brand": "morphe-anddea-amoled",
    "build-mode": "both",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.google.android.youtube",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "anddea/revanced-patches",
    "included-patches": [
      "MaterialYou"
    ],
    "patcher-args": "-e 'Theme' -OdarkThemeBackgroundColor=#000000 -OlightThemeBackgroundColor=#FFFFFF --continue-on-error",
    "uptodown-dlurl": "https://youtube.en.uptodown.com/android",
    "apkmirror-dlurl": "https://apkmirror.com/apk/google-inc/youtube",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.google.android.youtube",
    "dpi": [
      "nodpi",
      "anydpi",
      "auto"
    ]
  }
}
