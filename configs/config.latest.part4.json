{
  "patches-version": "absolutelatest",
  "enable-module-update": true,
  "brave-nightly-morphe-dh6k-arm64-v8a": {
    "enabled": true,
    "app-name": "brave-nightly",
    "rv-brand": "morphe-dh6k",
    "build-mode": "apk",
    "arch": "arm64-v8a",
    "pkg-name": "com.brave.browser_nightly",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "repo-dlurl": "https://github.com/brave/brave-browser/releases",
    "repo-dlurl-filter": "(BraveMonoarm64|MonoArm64)\\.apk$",
    "repo-dlurl-release-name-filter": "^Nightly v"
  },
  "goodreads-morphe-hoodles-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "goodreads",
    "rv-brand": "morphe-hoodles-exp",
    "github-dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.goodreads",
    "version": "latest",
    "build-mode": "apk",
    "arch": "all arm64-v8a arm-v7a x86_64",
    "pkg-name": "com.goodreads",
    "uptodown-dlurl": "https://goodreads.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/goodreads/goodreads",
    "dpi": "nodpi anydpi auto",
    "patches-source": "hoo-dles/morphe-patches"
  }
}
