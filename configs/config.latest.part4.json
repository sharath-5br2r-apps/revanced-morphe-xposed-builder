{
  "patches-version": "absolutelatest",
  "enable-module-update": true,
  "brave-nightly-morphe-dh6k-arm64-v8a": {
    "enabled": true,
    "app-name": "brave-nightly",
    "rv-brand": "morphe-dh6k",
    "build-mode": "apk",
    "arch": "arm64-v8a",
    "pkg-name": "com.brave.browser_nightly",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "repo-dlurl": "https://github.com/brave/brave-browser/releases",
    "repo-dlurl-filter": "(BraveMonoarm64|MonoArm64)\\.apk$",
    "repo-dlurl-release-name-filter": "^Nightly v"
  },
  "amazon-india-morphe-rushiranpise-exp": {
    "enabled": true,
    "app-name": "amazon-india",
    "rv-brand": "morphe-rushiranpise-exp",
    "build-mode": "apk",
    "pkg-name": "in.amazon.mShop.android.shopping",
    "cli-source": "MorpheApp/morphe-desktop",
    "uptodown-dlurl": "https://amazon-india.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/amazon-mobile-llc/amazon-india-shop-pay",
    "dpi": "nodpi anydpi auto",
    "patches-source": "rushiranpise/morphe-patches",
    "included-patches": "'Dark Mode' 'Open Links in Browser'",
    "excluded-patches": "'Hide Rufus Tab'",
    "custom-microg-patches": "'None'",
    "github-dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/in.amazon.mShop.android.shopping",
    "version": "latest",
    "arch": "all"
  }
}
