{
  "patches-version": "absolutelatest",
  "enable-module-update": true,
  "brave-beta-morphe-dh6k-arm-v7a": {
    "enabled": true,
    "app-name": "brave-beta",
    "rv-brand": "morphe-dh6k",
    "build-mode": "apk",
    "arch": "arm-v7a",
    "pkg-name": "com.brave.browser_beta",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "repo-dlurl": "https://github.com/brave/brave-browser/releases",
    "repo-dlurl-filter": "(BraveMonoarm|MonoArm)\\.apk$",
    "repo-dlurl-release-name-filter": "^Beta v"
  },
  "ventusky-morphe-hoodles-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "ventusky",
    "rv-brand": "morphe-hoodles-exp",
    "github-dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/cz.ackee.ventusky",
    "version": "latest",
    "build-mode": "apk",
    "arch": "all arm64-v8a arm-v7a x86_64",
    "pkg-name": "cz.ackee.ventusky",
    "uptodown-dlurl": "https://ventusky-weather-maps-and-radar.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/ventusky/ventusky-weather-maps-radar",
    "dpi": "nodpi anydpi auto",
    "patches-source": "hoo-dles/morphe-patches"
  },
  "adobe-acrobat-morphe-rushiranpise-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "adobe-acrobat",
    "rv-brand": "morphe-rushiranpise-exp",
    "github-dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.adobe.reader",
    "version": "latest",
    "build-mode": "apk",
    "arch": "all arm64-v8a x86_64",
    "pkg-name": "com.adobe.reader",
    "uptodown-dlurl": "https://adobe-reader.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/adobe/adobe-acrobat",
    "dpi": "nodpi anydpi auto",
    "patches-source": "rushiranpise/morphe-patches",
    "custom-microg-patches": "'None'"
  }
}
