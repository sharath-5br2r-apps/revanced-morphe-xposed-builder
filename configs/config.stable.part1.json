  },
  "nova-launcher-morphe-hoodles-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "nova-launcher",
    "rv-brand": "morphe-hoodles-exp",
    "github-dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.teslacoilsw.launcher",
    "version": "latest",
    "build-mode": "apk",
    "arch": "all",
    "pkg-name": "com.teslacoilsw.launcher",
