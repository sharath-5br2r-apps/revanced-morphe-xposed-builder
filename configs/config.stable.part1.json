{
  "patches-version": "latest",
  "enable-module-update": true,
  "brave-stable-morphe-kveld9": {
    "enabled": true,
    "app-name": "brave-stable",
    "rv-brand": "morphe-kveld9",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.brave.browser",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "kveld9/kveld-morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-dlurl-regex": [
      {
        "arch": "arm64-v8a",
        "regex": "(BraveMonoarm64|MonoArm64)\\.apk$"
      },
      {
        "arch": "arm-v7a",
        "regex": "(BraveMonoarm|MonoArm)\\.apk$"
      },
      {
        "arch": "x86_64",
        "regex": "(BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$"
      }
    ],
    "github-release-name-regex": "^Release v"
  },
  "adguard-morphe-rushiranpise-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "adguard",
    "rv-brand": "morphe-rushiranpise-exp",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.adguard.android",
    "version": "latest",
    "custom-microg-patches": "'None'",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.adguard.android",
    "uptodown-dlurl": "https://adguard-for-android.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/adguard-software-limited/adguard",
    "patches-source": "rushiranpise/morphe-patches"
  }
}
