{
  "patches-version": "latest",
  "enable-module-update": true,
  "brave-stable-morphe-kveld9-arm64-v8a": {
    "enabled": true,
    "app-name": "brave-stable",
    "rv-brand": "morphe-kveld9",
    "build-mode": "apk",
    "arch": "arm64-v8a",
    "pkg-name": "com.brave.browser",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "kveld9/kveld-morphe-patches",
    "patcher-args": "--continue-on-error",
    "repo-dlurl": "https://github.com/brave/brave-browser/releases",
    "repo-dlurl-filter": "(BraveMonoarm64|MonoArm64)\\.apk$",
    "repo-dlurl-release-name-filter": "^Release v"
  }
}
