{
  "patches-version": "latest",
  "enable-module-update": true,
  "brave-beta-morphe-dh6k": {
    "enabled": true,
    "app-name": "brave-beta",
    "rv-brand": "morphe-dh6k",
    "version": "beta",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.brave.browser_beta",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-dlurl-regex": [
      {
        "arch": "arm64-v8a",
        "regex": "(BraveMonoarm64|MonoArm64)\\.apk$"
      },
      {
        "arch": "arm-v7a",
        "regex": "(BraveMonoarm|MonoArm)\\.apk$"
      },
      {
        "arch": "x86_64",
        "regex": "(BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$"
      }
    ],
    "github-release-name-regex": "^Beta v"
  },
  "amazon-india-morphe-rushiranpise": {
    "enabled": true,
    "app-name": "amazon-india",
    "rv-brand": "morphe-rushiranpise",
    "build-mode": "apk",
    "pkg-name": "in.amazon.mShop.android.shopping",
    "cli-source": "MorpheApp/morphe-desktop",
    "uptodown-dlurl": "https://amazon-india.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/amazon-mobile-llc/amazon-india-shop-pay",
    "patches-source": "rushiranpise/morphe-patches",
    "included-patches": [
      "Dark Mode",
      "Open Links in Browser"
    ],
    "excluded-patches": [
      "Hide Rufus Tab"
    ],
    "custom-microg-patches": "'None'",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/in.amazon.mShop.android.shopping",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a"
    ]
  },
  "adobe-acrobat-morphe-rushiranpise-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "adobe-acrobat",
    "rv-brand": "morphe-rushiranpise-exp",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.adobe.reader",
    "version": "latest",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "x86_64"
    ],
    "pkg-name": "com.adobe.reader",
    "uptodown-dlurl": "https://adobe-reader.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/adobe/adobe-acrobat",
    "patches-source": "rushiranpise/morphe-patches",
    "custom-microg-patches": "'None'"
  },
  "windscribe-vpn-morphe-rushiranpise": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "windscribe-vpn",
    "rv-brand": "morphe-rushiranpise",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.windscribe.vpn",
    "custom-microg-patches": "'None'",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.windscribe.vpn",
    "uptodown-dlurl": "https://windscribe.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/windscribe/windscribe-vpn",
    "apkcombo-dlurl": "https://apkcombo.com/windscribe/com.windscribe.vpn",
    "patches-source": "rushiranpise/morphe-patches"
  },
  "adguard-morphe-rushiranpise-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "adguard",
    "rv-brand": "morphe-rushiranpise-exp",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.adguard.android",
    "version": "latest",
    "custom-microg-patches": "'None'",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.adguard.android",
    "uptodown-dlurl": "https://adguard-for-android.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/adguard-software-limited/adguard",
    "patches-source": "rushiranpise/morphe-patches"
  },
  "bluetooth-keyboard-mouse-morphe-rushiranpise": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "bluetooth-keyboard-mouse",
    "rv-brand": "morphe-rushiranpise",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/io.appground.blek",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "x86_64"
    ],
    "pkg-name": "io.appground.blek",
    "uptodown-dlurl": "https://bluetooth-keyboard-and-mouse.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/appground-io/bluetooth-keyboard-mouse-2/",
    "patches-source": "rushiranpise/morphe-patches"
  }
}
