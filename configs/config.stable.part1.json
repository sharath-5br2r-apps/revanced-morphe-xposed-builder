    "build-mode": "apk",
    "arch": "all",
    "pkg-name": "com.fingersoft.hillclimb",
    "uptodown-dlurl": "https://hill-climb-racing.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/fingersoft/hill-climb-racing/",
    "dpi": "nodpi anydpi auto",
    "patches-source": "byehi98/okish-morphe-patches"
  },
  "xrecorder-morphe-hoodles": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
