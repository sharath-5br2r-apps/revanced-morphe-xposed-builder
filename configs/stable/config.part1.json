{
  "patches-version": "stable",
  "enable-module-update": true,
  "YouTube-Morphe-Anddea": {
    "enable-module-update": true,
    "patches-source": "anddea/revanced-patches",
    "patch-brand": "Anddea",
    "cli-type": "morphe",
    "enabled": true,
    "app-name": "YouTube",
    "build-mode": "both",
    "pkg-name": "com.google.android.youtube",
    "included-patches": "'MaterialYou'",
    "patcher-args": "-e 'Theme' -OdarkThemeBackgroundColor=@android:color/black --continue-on-error",
    "uptodown-dlurl": "https://youtube.en.uptodown.com/android",
    "apkmirror-dlurl": "https://apkmirror.com/apk/google-inc/youtube"
  },
  "BraveBrowser-Nightly-Morphe-Dh6k": {
    "enable-module-update": true,
    "cli-type": "morphe",
    "enabled": true,
    "app-name": "Brave Browser",
    "patch-brand": "Dh6k",
    "sub-variant": "Nightly",
    "version": "beta",
    "arch": "arm64-v8a x86_64 armeabi-v7a x86",
    "pkg-name": "com.brave.browser_nightly",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-asset-regex": "arm64-v8a: BraveMonoarm64\\.apk$ | armeabi-v7a: BraveMonoarm\\.apk$ | x86_64: BraveMonox64\\.apk$ | x86: BraveMonox86\\.apk$",
