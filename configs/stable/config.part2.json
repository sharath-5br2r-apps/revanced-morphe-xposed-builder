{
  "patches-version": "stable",
  "enable-module-update": true,
  "BraveBrowser-Nightly-Morphe-Dh6k": {
    "enabled": true,
    "app-name": "Brave Browser",
    "cli-type": "morphe",
    "patch-brand": "Dh6k",
    "sub-variant": "Nightly",
    "version": "beta",
    "arch": "arm64-v8a x86_64 armeabi-v7a x86",
    "pkg-name": "com.brave.browser_nightly",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-asset-regex": "arm64-v8a: BraveMonoarm64\\.apk$ | armeabi-v7a: BraveMonoarm\\.apk$ | x86_64: BraveMonox64\\.apk$ | x86: BraveMonox86\\.apk$",
    "github-release-name-regex": "^Nightly v"
  },
  "BatteryGuru-Morphe-Hooman-Experimental": {
    "enable-module-update": true,
    "enabled": true,
    "app-name": "Battery Guru",
    "cli-type": "morphe",
    "patch-brand": "Hooman",
    "sub-variant": "Experimental",
    "version": "latest",
    "pkg-name": "com.paget96.batteryguru",
    "uptodown-dlurl": "https://battery-guru.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/paget96/battery-guru-health-saver/",
    "patches-source": "arandomhooman/hoomans-morphe-patches"
  },
  "MicrosoftSwiftKey-Morphe-Hooman": {
    "enable-module-update": true,
    "enabled": true,
    "app-name": "Microsoft SwiftKey",
    "cli-type": "morphe",
    "patch-brand": "Hooman",
    "pkg-name": "com.touchtype.swiftkey",
    "skip-patch-app-check": true,
    "uptodown-dlurl": "https://swiftkey-keyboard.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/swiftkey/swiftkey-keyboard",
    "patches-source": "arandomhooman/hoomans-morphe-patches"
  }
}
