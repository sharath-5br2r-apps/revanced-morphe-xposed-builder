{
  "patches-version": "stable",
  "enable-module-update": true,
  "YouTube-Morphe-AMOLED": {
    "enable-module-update": true,
    "patches-source": "MorpheApp/morphe-patches",
    "patch-brand": "morphe",
    "cli-type": "morphe",
    "enabled": true,
    "app-name": "YouTube",
    "variant": "AMOLED",
    "build-mode": "both",
    "pkg-name": "com.google.android.youtube",
    "included-patches": "'Theme'",
    "patcher-args": "-OdarkThemeBackgroundColor=#000000 -OlightThemeBackgroundColor=#FFFFFF",
    "uptodown-dlurl": "https://youtube.en.uptodown.com/android",
    "apkmirror-dlurl": "https://apkmirror.com/apk/google-inc/youtube",
    "apkpure-dlurl": "https://apkpure.com/youtube-app/com.google.android.youtube",
    "apkcombo-dlurl": "https://apkcombo.com/youtube/com.google.android.youtube"
  },
  "Twitter-Morphe-Piko-Experimental": {
    "enable-module-update": true,
    "patches-source": "crimera/piko",
    "patch-brand": "Piko",
    "cli-type": "morphe",
    "enabled": true,
    "app-name": "Twitter",
    "sub-variant": "Experimental",
    "version": "latest",
    "skip-patch-app-check": true,
    "pkg-name": "com.twitter.android",
    "excluded-patches": "'Dynamic Color'",
    "patcher-args": "--continue-on-error",
    "uptodown-dlurl": "https://twitter.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/x-corp/twitter/"
  }
}
