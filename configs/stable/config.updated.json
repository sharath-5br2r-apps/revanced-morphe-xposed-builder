{
  "patches-version": "stable",
  "enable-module-update": true,
  "BraveBrowser-Beta-Morphe-Dh6k": {
    "enabled": true,
    "app-name": "Brave Browser",
    "cli-type": "morphe",
    "patch-brand": "Dh6k",
    "sub-variant": "Beta",
    "version": "beta",
    "arch": "arm64-v8a x86_64 armeabi-v7a x86",
    "pkg-name": "com.brave.browser_beta",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-asset-regex": "arm64-v8a: BraveMonoarm64\\.apk$ | armeabi-v7a: BraveMonoarm\\.apk$ | x86_64: BraveMonox64\\.apk$ | x86: BraveMonox86\\.apk$",
    "github-release-name-regex": "^Beta v"
  },
  "BraveBrowser-Nightly-Morphe-Dh6k": {
    "enabled": true,
    "app-name": "Brave Browser",
    "cli-type": "morphe",
    "patch-brand": "Dh6k",
    "sub-variant": "Nightly",
    "version": "beta",
    "arch": "arm64-v8a x86_64 armeabi-v7a x86",
    "pkg-name": "com.brave.browser_nightly",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-asset-regex": "arm64-v8a: BraveMonoarm64\\.apk$ | armeabi-v7a: BraveMonoarm\\.apk$ | x86_64: BraveMonox64\\.apk$ | x86: BraveMonox86\\.apk$",
    "github-release-name-regex": "^Nightly v"
  },
  "Pinterest-Morphe-Browzomje-Experimental": {
    "enable-module-update": true,
    "enabled": true,
    "app-name": "Pinterest",
    "cli-type": "morphe",
    "patch-brand": "Browzomje",
    "sub-variant": "Experimental",
    "pkg-name": "com.pinterest",
    "version": "latest",
    "skip-patch-app-check": true,
    "uptodown-dlurl": "https://pinterest.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/pinterest/pinterest-one-destination-for-a-world-of-inspiration",
    "patches-source": "browzomje/browzomje-patches"
  }
