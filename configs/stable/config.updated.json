{
  "patches-version": "stable",
  "enable-module-update": true,
  "BraveBrowser-Morphe-Kveld9": {
    "enable-module-update": true,
    "cli-type": "morphe",
    "enabled": true,
    "app-name": "Brave Browser",
    "patch-brand": "Kveld9",
    "arch": "arm64-v8a x86_64 armeabi-v7a x86",
    "pkg-name": "com.brave.browser",
    "patches-source": "kveld9/kveld-morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-asset-regex": "arm64-v8a: BraveMonoarm64\\.apk$ | armeabi-v7a: BraveMonoarm\\.apk$ | x86_64: BraveMonox64\\.apk$ | x86: BraveMonox86\\.apk$",
    "github-release-name-regex": "^Release v"
  },
