{
  "patches-version": "absolutelatest",
  "enable-module-update": false,
  "brave-beta-morphe-dh6k": {
    "enabled": true,
    "app-name": "brave-beta",
    "rv-brand": "morphe-dh6k",
    "version": "beta",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.brave.browser_beta",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-dlurl-regex": [
      {
        "arch": "arm64-v8a",
        "regex": "(BraveMonoarm64|MonoArm64)\\.apk$"
      },
      {
        "arch": "arm-v7a",
        "regex": "(BraveMonoarm|MonoArm)\\.apk$"
      },
      {
        "arch": "x86_64",
        "regex": "(BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$"
      }
    ],
    "github-release-name-regex": "^Beta v"
  },
  "xrecorder-morphe-hoodles-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "xrecorder",
    "rv-brand": "morphe-hoodles-exp",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/videoeditor.videorecorder.screenrecorder",
    "version": "latest",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a"
    ],
    "pkg-name": "videoeditor.videorecorder.screenrecorder",
    "uptodown-dlurl": "https://videoeditor-videorecorder-screenrecorder.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/inshot-inc-2/screen-recorder-video-recorder-xrecorder",
    "patches-source": "hoo-dles/morphe-patches"
  },
  "amazon-india-morphe-rushiranpise-exp": {
    "enabled": true,
    "app-name": "amazon-india",
    "rv-brand": "morphe-rushiranpise-exp",
    "build-mode": "apk",
    "pkg-name": "in.amazon.mShop.android.shopping",
    "cli-source": "MorpheApp/morphe-desktop",
    "uptodown-dlurl": "https://amazon-india.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/amazon-mobile-llc/amazon-india-shop-pay",
    "patches-source": "rushiranpise/morphe-patches",
    "included-patches": [
      "Dark Mode",
      "Open Links in Browser"
    ],
    "excluded-patches": [
      "Hide Rufus Tab"
    ],
    "custom-microg-patches": "'None'",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/in.amazon.mShop.android.shopping",
    "version": "latest",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a"
    ]
  }
}
