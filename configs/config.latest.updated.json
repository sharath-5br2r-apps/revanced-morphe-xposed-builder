{
  "patches-version": "absolutelatest",
  "enable-module-update": false,
  "brave-nightly-morphe-dh6k": {
    "enabled": true,
    "app-name": "brave-nightly",
    "rv-brand": "morphe-dh6k",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.brave.browser_nightly",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-dlurl-regex": [
      {
        "arch": "arm64-v8a",
        "regex": "(BraveMonoarm64|MonoArm64)\\.apk$"
      },
      {
        "arch": "arm-v7a",
        "regex": "(BraveMonoarm|MonoArm)\\.apk$"
      },
      {
        "arch": "x86_64",
        "regex": "(BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$"
      }
    ],
    "github-release-name-regex": "^Nightly v"
  },
  "oxygen-updater-morphe-rushiranpise-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "oxygen-updater",
    "rv-brand": "morphe-rushiranpise-exp",
    "version": "latest",
    "custom-microg-patches": "'None'",
    "build-mode": "apk",
    "pkg-name": "com.arjanvlek.oxygenupdater",
    "github-dlurl": "https://github.com/oxygen-updater/os-updater",
    "patches-source": "rushiranpise/morphe-patches"
  }
}
