{
  "patches-version": "absolutelatest",
  "enable-module-update": true,
  "brave-nightly-morphe-dh6k": {
    "enabled": true,
    "app-name": "brave-nightly",
    "rv-brand": "morphe-dh6k",
    "version": "beta",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "pkg-name": "com.brave.browser_nightly",
    "cli-source": "MorpheApp/morphe-desktop",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-dlurl-regex": [
      {
        "arch": "arm64-v8a",
        "regex": "(BraveMonoarm64|MonoArm64)\\.apk$"
      },
      {
        "arch": "arm-v7a",
        "regex": "(BraveMonoarm|MonoArm)\\.apk$"
      },
      {
        "arch": "x86_64",
        "regex": "(BraveMonox64|BraveMonoX64|Monox64|MonoX64|[xX]64)\\.apk$"
      }
    ],
    "github-release-name-regex": "^Nightly v"
  },
  "nova-launcher-morphe-hoodles-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "nova-launcher",
    "rv-brand": "morphe-hoodles-exp",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.teslacoilsw.launcher",
    "version": "latest",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a"
    ],
    "pkg-name": "com.teslacoilsw.launcher",
    "uptodown-dlurl": "https://nova-launcher.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/instabridge-sweden-ab/nova-launcher",
    "dpi": [
      "nodpi",
      "anydpi",
      "auto"
    ],
    "patches-source": "hoo-dles/morphe-patches"
  },
  "poweramp-morphe-hooman-exp": {
    "enabled": true,
    "cli-source": "MorpheApp/morphe-desktop",
    "app-name": "poweramp",
    "rv-brand": "morphe-hooman-exp",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.maxmpz.audioplayer",
    "version": "latest",
    "build-mode": "apk",
    "arch": [
      "arm64-v8a"
    ],
    "pkg-name": "com.maxmpz.audioplayer",
    "uptodown-dlurl": "https://poweramp-music-player.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/max-mp/poweramp/",
    "apkpure-dlurl": "https://apkpure.com/poweramp-music-player-trial-app/com.maxmpz.audioplayer",
    "apkcombo-dlurl": "https://apkcombo.com/poweramp/com.maxmpz.audioplayer",
    "dpi": [
      "nodpi",
      "anydpi",
      "auto"
    ],
    "patches-source": "arandomhooman/hoomans-morphe-patches"
  },
  "discord-npatch-revenge": {
    "enabled": true,
    "app-name": "discord",
    "pkg-name": "com.discord",
    "rv-brand": "npatch-revenge",
    "build-mode": "apk",
    "arch": [
      "all",
      "arm64-v8a",
      "arm-v7a",
      "x86_64"
    ],
    "cli-source": "7723mod/NPatch",
    "cache_repo_dlurl": "https://github.com/sharath-5br2r-apps/apks-dump/releases/tag/com.discord",
    "patches-source": "revenge-mod/revenge-xposed",
    "patcher-args": "-l 0",
    "dpi": [
      "nodpi",
      "anydpi",
      "auto"
    ],
    "uptodown-dlurl": "https://discord-chat-for-gamers.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/discord/discord-chat-for-gamers",
    "apkmirror-example-url": "https://www.apkmirror.com/apk/discord/discord-chat-for-gamers/discord-talk-play-hang-out-341-13-stable-release/"
  }
}
